PORT=5000

# Cấu hình Neo4j Local (Neo4j Desktop hoặc Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Nếu bạn dùng Neo4j AuraDB Cloud, định dạng sẽ như sau:
# NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your_aura_password>

# Bật/tắt các endpoint nạp dữ liệu mẫu (/api/seed)
ENABLE_SEED_ROUTES=false
